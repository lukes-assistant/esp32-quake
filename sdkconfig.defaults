CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# CONFIG_ETH_USE_SPI_ETHERNET is not set
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# CONFIG_SPIRAM_MEMTEST is not set
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESP_SYSTEM_PANIC_GDBSTUB=y
# ESP32-P4-PC: the USB-C port is the chip's USB Serial/JTAG (no UART bridge)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# CONFIG_ESP_TASK_WDT_EN is not set
CONFIG_ESP_PANIC_HANDLER_IRAM=y
CONFIG_FATFS_LFN_STACK=y
CONFIG_LWIP_IP4_REASSEMBLY=y
CONFIG_LWIP_IP6_REASSEMBLY=y
CONFIG_LWIP_IP_REASS_MAX_PBUFS=30
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_EXT_PORT_SUPPORT_LS=y
# ESP32-P4-PC USB-A ports sit behind an onboard FE1.1s hub; allow a further hub
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y
# CONFIG_BSP_ERROR_CHECK is not set
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=2
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# ESP32-P4-PC display: HDMI via the onboard LT8912B DSI-to-HDMI bridge, which needs RGB888.
# 640x480@60: Quake renders at the display resolution (no PPA scaling), and HDMI scan-out
# takes ~55 MB/s of PSRAM bandwidth instead of ~166 MB/s at 1280x720 (see PERF_LOG.md).
CONFIG_BSP_I2C_NUM=1
CONFIG_BSP_I2C_FAST_MODE=y
CONFIG_BSP_LCD_TYPE_HDMI=y
CONFIG_BSP_LCD_HDMI_640x480_60HZ=y
CONFIG_BSP_LCD_COLOR_FORMAT_RGB888=y

# ESP32-P4 chip revision v1.0 on this board; IDF v5.5 defaults to rev >= v3.0
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# USB host DMA buffers (descriptor lists, transfer buffers) in PSRAM: internal DMA-capable RAM
# is nearly exhausted, and HID enumeration failed with ESP_ERR_NO_MEM when it ran out
CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=y
